# Copy these into Vercel → Project → Settings → Environment Variables.
# (Or into notify/.env.local for `vercel dev`. Never commit real values.)

# Shared PIN staff enter once on their device. Digits are easiest to type.
STAFF_PIN=2468

# Which delivery method to use: ntfy | telegram | pushover | twilio
NOTIFY_PROVIDER=ntfy

# ── ntfy (free push, no account) ─────────────────────────────────────────
# Pick a long random topic name — anyone who guesses it can read/post alerts.
NTFY_TOPIC=treasury-clinic-9f3k2m8x7q
# Optional: self-hosted ntfy server or ntfy.sh access token
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxx

# ── Telegram (free) ──────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789

# ── Pushover (one-time $5 app purchase) ──────────────────────────────────
# PUSHOVER_APP_TOKEN=axxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUSHOVER_USER_KEY=uxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (real SMS, paid) ──────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+1XXXXXXXXXX
# ALERT_PHONE=+1XXXXXXXXXX
