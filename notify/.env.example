# Copy these into Vercel → Project → Settings → Environment Variables.
# (Or into notify/.env.local for `vercel dev`. Never commit real values.)

# Shared PIN staff enter once on their device. Digits are easiest to type.
STAFF_PIN=2468

# Optional wording. Defaults shown.
# CLINIC_NAME=Treasury Medical
# ALERT_TITLE=You're needed

# Which delivery method to use: ntfy | telegram | pushover | twilio
NOTIFY_PROVIDER=ntfy

# ── ntfy (free push, no account) ─────────────────────────────────────────
# One topic per doctor, so only the doctor who was tapped is paged.
# Each topic name is its own secret: make it long and random, and give each
# doctor only their own. Anyone who guesses a name can read and post to it.
NTFY_TOPIC_LATSKY=treasury-latsky-4h8k2m9x7q
NTFY_TOPIC_TOM=treasury-tom-6p3v8w2r5t
NTFY_TOPIC_BAKER=treasury-baker-9j5n7c4z1b
NTFY_TOPIC_DIDONATO=treasury-didonato-2d6g3s8y4k

# Fallback used for any doctor whose own topic above is missing. Handy while
# rolling out, but note every subscriber to it hears every alert.
# NTFY_TOPIC=treasury-clinic-9f3k2m8x7q

# Optional: self-hosted ntfy server or ntfy.sh access token
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxx

# ── Telegram (free) ──────────────────────────────────────────────────────
# One bot, one chat id per doctor.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID_LATSKY=123456789
# TELEGRAM_CHAT_ID_TOM=234567890
# TELEGRAM_CHAT_ID_BAKER=345678901
# TELEGRAM_CHAT_ID_DIDONATO=456789012

# ── Pushover (one-time $5 app purchase) ──────────────────────────────────
# PUSHOVER_APP_TOKEN=axxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUSHOVER_USER_KEY_LATSKY=uxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUSHOVER_USER_KEY_TOM=uxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUSHOVER_USER_KEY_BAKER=uxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUSHOVER_USER_KEY_DIDONATO=uxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Twilio (real SMS, paid) ──────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+1XXXXXXXXXX
# ALERT_PHONE_LATSKY=+1XXXXXXXXXX
# ALERT_PHONE_TOM=+1XXXXXXXXXX
# ALERT_PHONE_BAKER=+1XXXXXXXXXX
# ALERT_PHONE_DIDONATO=+1XXXXXXXXXX
